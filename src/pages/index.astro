---
import Base from '../layouts/Base.astro';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const url=(p)=>base+p;
const collections=[
 {name:'Террасная доска',desc:'Красивые и долговечные покрытия для отдыха',img:url('/images/home/category-terrace-decking.webp'),href:'/catalog/'},
 {name:'Фасадные решения',desc:'Выразительная архитектура и защита фасада',img:url('/images/home/category-facade.webp'),href:'/catalog/'},
 {name:'Бамбуковые панели',desc:'Современная отделка стен и интерьеров',img:url('/images/home/category-bamboo-interior.webp'),href:'https://bamboo.nimtech.ru/'},
 {name:'Комплектующие',desc:'Подконструкция, опоры и системы крепления',img:url('/images/home/category-support-system.webp'),href:'/catalog/'}
];
const inspirations=[
 {name:'Терраса у загородного дома',img:'project-evening-terrace.webp'},
 {name:'Эксплуатируемая кровля',img:'project-rooftop.webp'},
 {name:'Терраса у бассейна',img:'project-pool-deck.webp'},
 {name:'Зона отдыха с джакузи',img:'project-hot-tub.webp'}
];
const benefits=[['01','Проектирование','Продумываем геометрию, раскладку доски и конструкцию основания.'],['02','Материалы','Подбираем доску, подконструкцию и крепёж под условия эксплуатации.'],['03','Монтаж','Собираем террасу от основания до финишных элементов.']];
---
<Base title="Террасы под ключ в Москве и Московской области — NimTech" description="NimTech: проектирование, материалы и монтаж террас под ключ в Москве и Московской области. Каталог террасной доски и расчёт проекта.">
<section class="hero">
 <img class="hero-photo" src={url('/images/home/hero-terrace-sunset.webp')} alt="Визуализация современной террасы с видом на озеро" fetchpriority="high"/>
 <div class="hero-shade"></div>
 <div class="hero-content"><div class="eyebrow light">NIMTECH · ТЕРРАСЫ ПОД КЛЮЧ</div><h1>Террасы под ключ<br/>в Москве и Подмосковье.</h1><p>Проектируем и строим террасы под ключ в Москве и Московской области: основание, металлокаркас, террасная доска ДПК, ступени и ограждения — от замера до сдачи.</p><div class="actions"><a class="primary" href={url('/terrasy-pod-klyuch/')}>Терраса под ключ <span>↗</span></a><a class="ghost" href={url('/projects/')}>Смотреть проекты <span>↗</span></a></div></div>
 <div class="hero-caption">01 / АРХИТЕКТУРА ОТДЫХА</div>
</section>
<section class="calculator-banner"><div class="calculator-visual"><img src={url('/images/home/calculator-hero-bg.webp')} alt="Визуализация террасы с открытой подконструкцией" loading="lazy"/></div><div class="calculator-shade"></div><div class="calculator-inner page-width"><div class="calculator-content"><div class="eyebrow">ОНЛАЙН-ПЛАНИРОВЩИК ТЕРРАСЫ</div><h2>Рассчитайте террасу<br/>за несколько минут</h2><p>Укажите размеры, форму и тип основания — перейдите к проектированию и подбору материалов.</p><div class="calculator-actions"><a class="calculator-button calculator-gradient gradient-warm" href={url('/calculator/')}>Перейти к калькулятору <span>→</span></a><button type="button" class="calculator-button calculator-gradient gradient-cool" id="open-lead-form">Оставить заявку <span>→</span></button></div><div class="calculator-benefits"><span>◇ Любая геометрия</span><span>▦ Расчёт конструкции</span><span>▱ Подбор материалов</span></div></div></div></section>
<section class="intro page-width"><div><div class="eyebrow">О КОМПАНИИ</div><h2>От идеи до готовой террасы.</h2></div><div><p>Мы объединяем инженерный подход, качественные материалы и аккуратный монтаж. Создаём террасы, которые естественно продолжают архитектуру дома.</p><a class="text-link" href={url('/terrasy-pod-klyuch/')}>Подробнее о строительстве <span>↗</span></a></div></section>
<section class="section page-width"><div class="section-head"><div><div class="eyebrow">НАШИ РЕШЕНИЯ</div><h2>Популярные направления</h2></div><a class="text-link" href={url('/catalog/')}>Весь каталог ↗</a></div><div class="product-grid">{collections.map(item=><a class="product" href={item.href.startsWith("http")?item.href:url(item.href)}><div class="product-image"><img src={item.img} alt={item.name} loading="lazy"/></div><div class="product-info"><h3>{item.name}</h3><p>{item.desc}</p><span>Подробнее ↗</span></div></a>)}</div></section>
<section class="dark-section"><div class="page-width"><div class="eyebrow light">ТЕРРАСЫ ПОД КЛЮЧ</div><div class="dark-grid"><h2>Продуманная конструкция.<br/>Красивый результат.</h2><div><p>Для каждого основания — своё инженерное решение: винтовые сваи, бетонная плита или эксплуатируемая кровля.</p><a class="white-button" href={url('/terrasy-pod-klyuch/')}>Наш подход ↗</a></div></div><div class="steps">{benefits.map(b=><div class="step"><span>{b[0]}</span><h3>{b[1]}</h3><p>{b[2]}</p></div>)}</div></div></section>

<section class="section page-width"><div class="section-head"><div><div class="eyebrow">ИДЕИ ДЛЯ ВАШЕГО ПРОЕКТА</div><h2>Пространства, которые вдохновляют</h2></div><a class="text-link" href={url('/projects/')}>Наши реальные объекты ↗</a></div><p class="inspiration-note">Концептуальные визуализации возможных решений, не фотографии выполненных объектов NimTech.</p><div class="inspiration-grid">{inspirations.map(item=><div class="inspiration-card"><img src={url('/images/home/'+item.img)} alt={'Визуализация: '+item.name} loading="lazy"/><h3>{item.name}</h3></div>)}</div></section>
<section class="section page-width"><div class="section-head"><div><div class="eyebrow">ЭКСПЕРТИЗА NIMTECH</div><h2>Знания, которыми делимся</h2></div></div><div class="editorial"><a href={url('/video/')}><div class="editorial-image"><img src={url('/images/home/material-board-profile.webp')} alt="Архитектура современного дома" loading="lazy"/></div><span>ВИДЕО</span><h3>Обзоры материалов и технологии монтажа ↗</h3></a><a href={url('/blog/')}><div class="editorial-image"><img src={url('/images/home/material-texture.webp')} alt="Современный загородный дом" loading="lazy"/></div><span>БЛОГ</span><h3>Советы по выбору и строительству террас ↗</h3></a></div></section>
<section class="cta"><div class="page-width"><div class="eyebrow light">ВАШ БУДУЩИЙ ПРОЕКТ</div><h2>Хорошая терраса<br/>начинается с идеи.</h2><p>Расскажите нам о вашем проекте — поможем выбрать решение.</p><a class="white-button" href={url('/contacts/')}>Обсудить проект ↗</a></div></section>

</Base>
<style>
:global(body){background:#f8f8f6}:global(main){overflow:hidden}:global(header){position:relative;z-index:5}
.page-width{max-width:1320px;margin:auto;padding-left:30px;padding-right:30px}.hero{height:min(780px,85vh);min-height:590px;position:relative;color:white;display:flex;align-items:center}.hero-photo,.hero-shade{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.hero-shade{background:linear-gradient(90deg,rgba(0,0,0,.75),rgba(0,0,0,.34) 70%,rgba(0,0,0,.18))}.hero-content{position:relative;z-index:1;width:min(1250px,100%);padding:50px 30px;margin:auto}.hero h1{font-size:clamp(44px,6.4vw,100px);line-height:1.02;letter-spacing:-.055em;margin:26px 0}.hero p{color:#eee;font-size:19px;max-width:580px}.eyebrow{font-size:12px;letter-spacing:.2em;font-weight:700;color:#777}.eyebrow.light{color:#ddd}.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:34px}.primary,.ghost,.white-button{display:inline-flex;gap:38px;align-items:center;justify-content:space-between;padding:18px 24px;border-radius:4px;font-weight:650;font-size:14px}.primary{background:#fff;color:#171717}.ghost{border:1px solid #ffffff9c;color:white}.hero-caption{position:absolute;bottom:28px;right:5%;font-size:11px;letter-spacing:.18em}.intro{padding-top:115px;padding-bottom:110px;display:grid;grid-template-columns:1fr 1fr;gap:90px}.intro h2,.section h2,.feature h2{font-size:clamp(36px,4vw,58px);letter-spacing:-.05em;line-height:1.08;margin:18px 0}.intro p,.feature p{font-size:19px;line-height:1.65}.text-link{display:inline-flex;gap:26px;margin-top:20px;border-bottom:1px solid #222;padding-bottom:9px;font-size:14px;font-weight:650}.section{padding-top:60px;padding-bottom:120px}.section-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:34px}.product-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px}.product{background:#fff}.product-image{height:265px;overflow:hidden;background:#ddd}.product-image img,.feature-image img,.editorial-image img{width:100%;height:100%;object-fit:cover;transition:transform .5s}.product:hover img,.editorial a:hover img{transform:scale(1.045)}.product-info{padding:24px 8px}.product h3{font-size:21px;margin:0 0 8px;letter-spacing:-.03em}.product p{font-size:15px;margin:0 0 18px}.product span{font-size:13px;font-weight:700}.dark-section{background:#191b1a;color:white;padding:110px 0}.dark-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:80px}.dark-grid h2,.cta h2{font-size:clamp(38px,5vw,70px);line-height:1.06;letter-spacing:-.05em;margin:20px 0 65px}.dark-grid p,.step p,.cta p{color:#b9bfbb}.white-button{background:#fff;color:#161616;margin-top:15px}.steps{border-top:1px solid #555;display:grid;grid-template-columns:repeat(3,1fr);gap:30px;padding-top:35px}.step span{color:#999;font-size:13px}.step h3{font-size:24px;margin:30px 0 12px}.step p{font-size:15px}.feature{padding-top:120px;padding-bottom:120px;display:grid;grid-template-columns:1.15fr 1fr;gap:80px;align-items:center}.feature-image{height:520px}.feature-copy .primary{background:#171717;color:#fff;margin-top:25px}.editorial{display:grid;grid-template-columns:1fr 1fr;gap:24px}.editorial-image{height:350px;overflow:hidden}.editorial span{font-size:12px;letter-spacing:.15em;color:#777;display:block;margin-top:22px}.editorial h3{font-size:25px;letter-spacing:-.03em}.cta{background:#333d37;color:white;padding:100px 0 120px}.cta h2{margin-bottom:20px}.cta p{font-size:18px}
@media(max-width:800px){.hero{min-height:610px;height:75vh}.hero h1{font-size:clamp(42px,10vw,68px)}.hero p{font-size:16px}.intro,.dark-grid,.feature{grid-template-columns:1fr;gap:25px}.intro{padding-top:75px;padding-bottom:50px}.section{padding-bottom:70px}.product-grid{grid-template-columns:1fr}.product-image{height:260px}.steps{grid-template-columns:1fr}.dark-section{padding:70px 0}.dark-grid h2{margin-bottom:15px}.feature{padding-top:70px;padding-bottom:70px}.feature-image{height:310px}.editorial{grid-template-columns:1fr}.editorial-image{height:270px}.section-head{align-items:start;flex-direction:column}.cta{padding:70px 0}}
.inspiration-note{font-size:13px;color:#777;margin:-12px 0 26px}.inspiration-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}.inspiration-card img{width:100%;height:230px;object-fit:cover;border-radius:8px}.inspiration-card h3{font-size:15px;letter-spacing:-.02em;margin:12px 0}@media(max-width:1000px){.product-grid,.inspiration-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.product-grid,.inspiration-grid{grid-template-columns:1fr}.inspiration-card img{height:230px}}
.calculator-banner{position:relative;min-height:520px;background:#f4f3ef;display:flex;align-items:center;overflow:hidden}.calculator-visual{position:absolute;inset:0 0 0 39%}.calculator-visual img{width:100%;height:100%;object-fit:cover}.calculator-shade{position:absolute;inset:0;background:linear-gradient(90deg,#f4f3ef 0%,#f4f3ef 29%,rgba(244,243,239,.96) 38%,rgba(244,243,239,.08) 62%,transparent 80%)}.calculator-inner{position:relative;z-index:1;width:100%;padding-top:65px;padding-bottom:65px}.calculator-content{max-width:530px}.calculator-content h2{font-size:clamp(34px,4vw,56px);line-height:1.1;letter-spacing:-.05em;margin:18px 0;color:#172024}.calculator-content p{font-size:17px;line-height:1.55;color:#454b50}.calculator-actions{display:flex;gap:20px;align-items:center;flex-wrap:wrap;margin-top:28px}.calculator-button{background:#152025;color:white;border-radius:6px;padding:17px 23px;font-size:14px;font-weight:650}.calculator-secondary{font-size:14px;border-bottom:1px solid #152025;padding-bottom:6px}.calculator-benefits{display:flex;gap:22px;flex-wrap:wrap;margin-top:46px;font-size:12px;font-weight:600}@media(max-width:800px){.calculator-banner{display:block}.calculator-visual{position:relative;inset:auto;height:300px}.calculator-shade{display:none}.calculator-inner{padding-top:34px;padding-bottom:44px}.calculator-benefits{margin-top:28px;gap:14px}}@media(max-width:450px){.calculator-visual{height:220px}}
.calculator-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;max-width:590px}.calculator-gradient{position:relative;display:flex;justify-content:space-between;align-items:center;gap:12px;min-height:66px;width:100%;border:0;border-radius:12px;padding:18px 20px;color:white;font:650 14px Inter,Arial,sans-serif;cursor:pointer;background-size:230% 230%;animation:gradient-flow 5s ease-in-out infinite,cta-glow 3.4s ease-in-out infinite;box-shadow:0 10px 25px rgba(63,48,140,.2);transition:transform .2s,box-shadow .2s}.calculator-gradient:hover{transform:translateY(-3px);box-shadow:0 14px 32px rgba(63,48,140,.3)}.calculator-gradient:focus-visible{outline:3px solid #161616;outline-offset:3px}.gradient-warm{background-image:linear-gradient(110deg,#ff961d,#ff385c,#ad15ce,#ff961d)}.gradient-cool{background-image:linear-gradient(110deg,#b52be6,#6237fc,#0878ff,#b52be6)}@keyframes gradient-flow{0%,100%{background-position:0% 50%}50%{background-position:100% 50%}}@keyframes cta-glow{0%,100%{filter:brightness(1)}50%{filter:brightness(1.12)}}@media(prefers-reduced-motion:reduce){.calculator-gradient{animation:none}}.lead-dialog{border:0;border-radius:18px;padding:0;width:min(94vw,490px);box-shadow:0 25px 90px #0006}.lead-dialog::backdrop{background:#0b1010a8;backdrop-filter:blur(5px)}.lead-form{display:flex;flex-direction:column;gap:12px;padding:34px;position:relative}.lead-form h2{font-size:30px;letter-spacing:-.04em;margin:8px 0 0}.lead-form p{font-size:14px;line-height:1.55;margin:0 0 12px}.lead-form label{font-size:13px;font-weight:650}.lead-form>input{border:1px solid #c9cecc;border-radius:9px;padding:15px;font-size:16px;width:100%}.lead-close{position:absolute;right:16px;top:12px;background:none;border:0;font-size:30px;cursor:pointer}.lead-consent{display:flex;gap:10px;align-items:flex-start;font-weight:400!important;line-height:1.5}.lead-consent input{margin-top:4px}.lead-consent a{text-decoration:underline}.lead-submit{background:#152025;color:#fff;border:0;border-radius:9px;padding:17px;cursor:pointer;font-size:15px;font-weight:700}.lead-form small{color:#69706d;line-height:1.5}@media(max-width:550px){.calculator-actions{grid-template-columns:1fr}.lead-form{padding:25px}}
</style>