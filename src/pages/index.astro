---
import Base from '../layouts/Base.astro';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const url=(p)=>base+p;
const collections=[
 {name:'Террасная доска ДПК',desc:'Практичные покрытия для террас и зон отдыха',img:'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?w=1100&q=82'},
 {name:'Подконструкция',desc:'Металлические лаги, балки и крепёж',img:'https://images.unsplash.com/photo-1600566753190-17f0baa2a6c3?w=1100&q=82'},
 {name:'Регулируемые опоры',desc:'Надёжные решения для разных оснований',img:'https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?w=1100&q=82'}
];
const benefits=[['01','Проектирование','Продумываем геометрию, раскладку доски и конструкцию основания.'],['02','Материалы','Подбираем доску, подконструкцию и крепёж под условия эксплуатации.'],['03','Монтаж','Собираем террасу от основания до финишных элементов.']];
---
<Base title="Террасы под ключ в Москве и Московской области — NimTech" description="NimTech: проектирование, материалы и монтаж террас под ключ в Москве и Московской области. Каталог террасной доски и расчёт проекта.">
<section class="hero">
 <img class="hero-photo" src="https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?w=2000&q=85" alt="Современная загородная архитектура с просторной зоной отдыха" fetchpriority="high"/>
 <div class="hero-shade"></div>
 <div class="hero-content"><div class="eyebrow light">NIMTECH · ТЕРРАСЫ ПОД КЛЮЧ</div><h1>Пространство,<br/>в которое хочется<br/>возвращаться.</h1><p>Проектируем и строим террасы для загородных домов, крыш и коммерческих пространств в Москве и области.</p><div class="actions"><a class="primary" href={url('/calculator/')}>Рассчитать террасу <span>↗</span></a><a class="ghost" href={url('/projects/')}>Смотреть проекты <span>↗</span></a></div></div>
 <div class="hero-caption">01 / АРХИТЕКТУРА ОТДЫХА</div>
</section>
<section class="intro page-width"><div><div class="eyebrow">О КОМПАНИИ</div><h2>От идеи до готовой террасы.</h2></div><div><p>Мы объединяем инженерный подход, качественные материалы и аккуратный монтаж. Создаём террасы, которые естественно продолжают архитектуру дома.</p><a class="text-link" href={url('/terrasy-pod-klyuch/')}>Подробнее о строительстве <span>↗</span></a></div></section>
<section class="section page-width"><div class="section-head"><div><div class="eyebrow">НАШИ РЕШЕНИЯ</div><h2>Всё для вашей террасы</h2></div><a class="text-link" href={url('/catalog/')}>Весь каталог ↗</a></div><div class="product-grid">{collections.map(item=><a class="product" href={url('/catalog/')}><div class="product-image"><img src={item.img} alt={item.name} loading="lazy"/></div><div class="product-info"><h3>{item.name}</h3><p>{item.desc}</p><span>Подробнее ↗</span></div></a>)}</div></section>
<section class="dark-section"><div class="page-width"><div class="eyebrow light">ТЕРРАСЫ ПОД КЛЮЧ</div><div class="dark-grid"><h2>Продуманная конструкция.<br/>Красивый результат.</h2><div><p>Для каждого основания — своё инженерное решение: винтовые сваи, бетонная плита или эксплуатируемая кровля.</p><a class="white-button" href={url('/terrasy-pod-klyuch/')}>Наш подход ↗</a></div></div><div class="steps">{benefits.map(b=><div class="step"><span>{b[0]}</span><h3>{b[1]}</h3><p>{b[2]}</p></div>)}</div></div></section>
<section class="feature page-width"><div class="feature-image"><img src="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?w=1300&q=85" alt="Современное архитектурное пространство" loading="lazy"/></div><div class="feature-copy"><div class="eyebrow">ОНЛАЙН-КАЛЬКУЛЯТОР</div><h2>Начните с точного расчёта.</h2><p>Задайте размеры террасы и перейдите к проектированию конструкции. Интерактивный калькулятор будет доступен на отдельной странице сайта.</p><a class="primary" href={url('/calculator/')}>Открыть калькулятор ↗</a></div></section>
<section class="section page-width"><div class="section-head"><div><div class="eyebrow">ЭКСПЕРТИЗА NIMTECH</div><h2>Знания, которыми делимся</h2></div></div><div class="editorial"><a href={url('/video/')}><div class="editorial-image"><img src="https://images.unsplash.com/photo-1600566752355-35792bedcfea?w=1200&q=80" alt="Архитектура современного дома" loading="lazy"/></div><span>ВИДЕО</span><h3>Обзоры материалов и технологии монтажа ↗</h3></a><a href={url('/blog/')}><div class="editorial-image"><img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=1200&q=80" alt="Современный загородный дом" loading="lazy"/></div><span>БЛОГ</span><h3>Советы по выбору и строительству террас ↗</h3></a></div></section>
<section class="cta"><div class="page-width"><div class="eyebrow light">ВАШ БУДУЩИЙ ПРОЕКТ</div><h2>Хорошая терраса<br/>начинается с идеи.</h2><p>Расскажите нам о вашем проекте — поможем выбрать решение.</p><a class="white-button" href={url('/contacts/')}>Обсудить проект ↗</a></div></section>
</Base>
<style>
:global(body){background:#f8f8f6}:global(main){overflow:hidden}:global(header){position:relative;z-index:5}
.page-width{max-width:1320px;margin:auto;padding-left:30px;padding-right:30px}.hero{height:min(780px,85vh);min-height:590px;position:relative;color:white;display:flex;align-items:center}.hero-photo,.hero-shade{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.hero-shade{background:linear-gradient(90deg,rgba(0,0,0,.75),rgba(0,0,0,.34) 70%,rgba(0,0,0,.18))}.hero-content{position:relative;z-index:1;width:min(1250px,100%);padding:50px 30px;margin:auto}.hero h1{font-size:clamp(44px,6.4vw,100px);line-height:1.02;letter-spacing:-.055em;margin:26px 0}.hero p{color:#eee;font-size:19px;max-width:580px}.eyebrow{font-size:12px;letter-spacing:.2em;font-weight:700;color:#777}.eyebrow.light{color:#ddd}.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:34px}.primary,.ghost,.white-button{display:inline-flex;gap:38px;align-items:center;justify-content:space-between;padding:18px 24px;border-radius:4px;font-weight:650;font-size:14px}.primary{background:#fff;color:#171717}.ghost{border:1px solid #ffffff9c;color:white}.hero-caption{position:absolute;bottom:28px;right:5%;font-size:11px;letter-spacing:.18em}.intro{padding-top:115px;padding-bottom:110px;display:grid;grid-template-columns:1fr 1fr;gap:90px}.intro h2,.section h2,.feature h2{font-size:clamp(36px,4vw,58px);letter-spacing:-.05em;line-height:1.08;margin:18px 0}.intro p,.feature p{font-size:19px;line-height:1.65}.text-link{display:inline-flex;gap:26px;margin-top:20px;border-bottom:1px solid #222;padding-bottom:9px;font-size:14px;font-weight:650}.section{padding-top:60px;padding-bottom:120px}.section-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:34px}.product-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.product{background:#fff}.product-image{height:310px;overflow:hidden;background:#ddd}.product-image img,.feature-image img,.editorial-image img{width:100%;height:100%;object-fit:cover;transition:transform .5s}.product:hover img,.editorial a:hover img{transform:scale(1.045)}.product-info{padding:24px 8px}.product h3{font-size:24px;margin:0 0 8px;letter-spacing:-.03em}.product p{font-size:15px;margin:0 0 18px}.product span{font-size:13px;font-weight:700}.dark-section{background:#191b1a;color:white;padding:110px 0}.dark-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:80px}.dark-grid h2,.cta h2{font-size:clamp(38px,5vw,70px);line-height:1.06;letter-spacing:-.05em;margin:20px 0 65px}.dark-grid p,.step p,.cta p{color:#b9bfbb}.white-button{background:#fff;color:#161616;margin-top:15px}.steps{border-top:1px solid #555;display:grid;grid-template-columns:repeat(3,1fr);gap:30px;padding-top:35px}.step span{color:#999;font-size:13px}.step h3{font-size:24px;margin:30px 0 12px}.step p{font-size:15px}.feature{padding-top:120px;padding-bottom:120px;display:grid;grid-template-columns:1.15fr 1fr;gap:80px;align-items:center}.feature-image{height:520px}.feature-copy .primary{background:#171717;color:#fff;margin-top:25px}.editorial{display:grid;grid-template-columns:1fr 1fr;gap:24px}.editorial-image{height:350px;overflow:hidden}.editorial span{font-size:12px;letter-spacing:.15em;color:#777;display:block;margin-top:22px}.editorial h3{font-size:25px;letter-spacing:-.03em}.cta{background:#333d37;color:white;padding:100px 0 120px}.cta h2{margin-bottom:20px}.cta p{font-size:18px}
@media(max-width:800px){.hero{min-height:610px;height:75vh}.hero h1{font-size:clamp(42px,10vw,68px)}.hero p{font-size:16px}.intro,.dark-grid,.feature{grid-template-columns:1fr;gap:25px}.intro{padding-top:75px;padding-bottom:50px}.section{padding-bottom:70px}.product-grid{grid-template-columns:1fr}.product-image{height:260px}.steps{grid-template-columns:1fr}.dark-section{padding:70px 0}.dark-grid h2{margin-bottom:15px}.feature{padding-top:70px;padding-bottom:70px}.feature-image{height:310px}.editorial{grid-template-columns:1fr}.editorial-image{height:270px}.section-head{align-items:start;flex-direction:column}.cta{padding:70px 0}}
</style>