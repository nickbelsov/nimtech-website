---
import Base from '../../layouts/Base.astro';
import Catalog from '../../components/Catalog.astro';
import TurnkeyProcess from '../../components/TurnkeyProcess.astro';
const sections={
 'terrasy-pod-klyuch':['Террасы под ключ','Проектирование, подбор материалов и профессиональный монтаж террас.'],
 'catalog':['Каталог материалов','Террасная доска ДПК, металлокаркас, опоры и крепёж. Каталог будет наполнен товарными позициями.'],
 'projects':['Наши проекты','Здесь появятся фотографии, характеристики и истории реализованных объектов.'],
 'calculator':['Калькулятор террасы','Полноценная интерактивная версия калькулятора будет перенесена из существующего проекта calc.'],
 'blog':['Блог','Статьи о проектировании, монтаже, материалах и уходе за террасами.'],
 'video':['Видео','Обзоры и инструкции с YouTube-канала NimTech. Автоматическую синхронизацию подключим отдельно.'],
 'contacts':['Контакты','Свяжитесь с NimTech для консультации и расчёта проекта.']
};
export function getStaticPaths(){return ['terrasy-pod-klyuch','catalog','projects','calculator','blog','video','contacts'].map(section=>({params:{section}}));}
import catalog from '../../data/catalog.json';
const catalogGroups=[
 {title:'Террасная доска',desc:'ДПК и другие покрытия для террас, веранд и зон отдыха',slug:'decking'},
 {title:'Ступени и финишные элементы',desc:'Оформление ступеней, торцов и примыканий',slug:'steps'},
 {title:'Фасадные материалы',desc:'Фасадная доска и реечные панели',slug:'facade'},
 {title:'Ограждения и заборы',desc:'Доска и элементы ограждений',slug:'fences'},
 {title:'Металлическая подконструкция',desc:'Профиль для несущего каркаса террасы',slug:'metal'},
 {title:'Опоры и крепёж',desc:'Регулируемые опоры, кляймеры и комплектующие',slug:'hardware'}
];
const collections=['Alpha','Beta','Gamma','Mars','GR','SM / CM Decking'];
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const [title,description]=sections[Astro.params.section];
---
<Base title={title+' — NimTech'} description={description}>{Astro.params.section === "catalog" ? <Catalog /> : Astro.params.section === "terrasy-pod-klyuch" ? <TurnkeyProcess /> : Astro.params.section === "contacts" ? <section class="wrap"><h1>Контакты NimTech</h1><p>Поможем подобрать материалы, рассчитать стоимость и обсудить строительство террасы под ключ.</p><div class="contact-grid"><div class="card"><h2>Связаться</h2><p><a href="tel:+74950673837">+7 (495) 067-38-37</a></p><p><a href="https://t.me/+79770893443" target="_blank" rel="noopener noreferrer">Написать в Telegram ↗</a></p><p><a href="mailto:info@nimtech.ru">info@nimtech.ru</a></p></div><div class="card"><h2>Реквизиты</h2><p><strong>ООО «Нимтек»</strong></p><p>ИНН: 6313560509</p><p>ОГРН: 1226300007581</p><p>КПП: 631301001</p><p>Шоурум: Москва, Киевское шоссе, 22-й км, д. 4, стр. 1, корп. Г, павильон 306Г, 3-й этаж, бизнес-парк «Румянцево»</p><p>Генеральный директор: Белоусов Николай Владимирович</p><p><a href={base+"/privacy/"}>Политика конфиденциальности</a></p><p><a href={base+"/personal-data/"}>Правила обработки персональных данных</a></p></div></div><section class="showroom-gallery"><div class="showroom-gallery-heading"><span class="projects-kicker">NIMTECH / МОСКВА</span><h2>Наш шоурум</h2><p>Посмотрите образцы террасной доски, ограждений и готовые варианты отделки. В шоуруме можно сравнить фактуры, цвета и конструктивные решения.</p></div><div class="showroom-photos"><img src={base+"/images/showroom/showroom-01.webp"} alt="Шоурум NimTech: экспозиция террасной доски, ступеней и ограждений" loading="lazy"/><img src={base+"/images/showroom/showroom-02.webp"} alt="Вход в шоурум NimTech в бизнес-парке Румянцево" loading="lazy"/><img src={base+"/images/showroom/showroom-03.webp"} alt="Консультационная зона шоурума NimTech" loading="lazy"/></div></section><div class="showroom-map"><h2>Шоурум NimTech на карте</h2><p>Москва, Киевское шоссе, 22-й километр, д. 4, стр. 1, корп. Г, павильон 306Г, 3-й этаж, бизнес-парк «Румянцево».</p><iframe title="Карта проезда к шоуруму NimTech в бизнес-парке Румянцево" src="https://yandex.ru/map-widget/v1/?text=%D0%91%D0%B8%D0%B7%D0%BD%D0%B5%D1%81-%D0%BF%D0%B0%D1%80%D0%BA%20%D0%A0%D1%83%D0%BC%D1%8F%D0%BD%D1%86%D0%B5%D0%B2%D0%BE%2C%20%D0%9A%D0%B8%D0%B5%D0%B2%D1%81%D0%BA%D0%BE%D0%B5%20%D1%88%D0%BE%D1%81%D1%81%D0%B5%2C%2022-%D0%B9%20%D0%BA%D0%BC%2C%204" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe><p><a href="https://yandex.ru/maps/?text=%D0%91%D0%B8%D0%B7%D0%BD%D0%B5%D1%81-%D0%BF%D0%B0%D1%80%D0%BA%20%D0%A0%D1%83%D0%BC%D1%8F%D0%BD%D1%86%D0%B5%D0%B2%D0%BE%20%D0%9C%D0%BE%D1%81%D0%BA%D0%B2%D0%B0" target="_blank" rel="noopener noreferrer">Открыть маршрут в Яндекс Картах ↗</a></p></div></section> : Astro.params.section === "projects" ? <section class="projects-portfolio"><div class="projects-portfolio-head"><span class="projects-kicker">NIMTECH / РЕАЛИЗОВАННЫЕ ОБЪЕКТЫ</span><h1>Наши работы</h1><p>Примеры террас и архитектурных решений из древесно-полимерного композита.</p></div><article class="portfolio-project"><div class="portfolio-cover"><img src={base+"/images/projects/terrace-pool-01.webp"} alt="Терраса из ДПК вокруг прямоугольного бассейна, общий вид вечером" loading="eager"/></div><div class="portfolio-details"><div><span class="projects-kicker">ПРОЕКТ 01 / ТЕРРАСЫ И ЗОНЫ ОТДЫХА</span><h2>Терраса вокруг бассейна</h2><p>Просторная террасная площадка вокруг частного открытого бассейна. Настил формирует единую зону отдыха, соединяя бассейн с участком и прилегающими постройками.</p><p>На фотографиях — вечерние виды объекта в процессе завершающих работ. Видны террасное покрытие, обрамление бассейна и примыкания к дорожкам.</p><div class="portfolio-tags"><span>Терраса у бассейна</span><span>Загородный участок</span><span>Вечерняя съёмка</span></div><button type="button" class="nimtech-glow" data-lead-open data-lead-form="projects">Рассчитать похожий проект →</button></div><div class="portfolio-gallery"><img src={base+"/images/projects/terrace-pool-02.webp"} alt="Вид на террасу из ДПК вдоль бассейна и остеклённую постройку" loading="lazy"/><img src={base+"/images/projects/terrace-pool-03.webp"} alt="Вид на террасу вокруг бассейна со стороны дома" loading="lazy"/></div></div></article><article class="portfolio-project portfolio-project-second"><div class="portfolio-cover"><img src={base+"/images/projects/terrace-house-01.webp"} alt="Терраса из ДПК с широкими ступенями у загородного дома" loading="lazy"/></div><div class="portfolio-details"><div><span class="projects-kicker">ПРОЕКТ 02 / ТЕРРАСА У ДОМА</span><h2>Терраса с широкими ступенями у загородного дома</h2><p>Светлая террасная площадка вдоль фасада современного одноэтажного дома. Настил образует просторную зону отдыха с мебелью, а широкие ступени обеспечивают удобный переход к дорожкам и участку.</p><p>Особое внимание уделено аккуратной отделке торцов и подступенков. Тёплый оттенок покрытия гармонирует с вертикальными фасадными панелями и ландшафтным оформлением.</p><div class="portfolio-tags"><span>Терраса у дома</span><span>Широкие ступени</span><span>Зона отдыха</span></div><button type="button" class="nimtech-glow" data-lead-open data-lead-form="projects">Рассчитать похожий проект →</button></div><div class="portfolio-gallery"><img src={base+"/images/projects/terrace-house-02.webp"} alt="Террасный настил и лестница вдоль фасада дома" loading="lazy"/><img src={base+"/images/projects/terrace-house-03.webp"} alt="Просторная площадка с садовой мебелью" loading="lazy"/><img src={base+"/images/projects/terrace-house-04.webp"} alt="Ступени и отделка боковой части террасы" loading="lazy"/><img src={base+"/images/projects/terrace-house-05.webp"} alt="Общий вид загородного дома с террасой" loading="lazy"/></div></div></article><article class="portfolio-project portfolio-project-second"><div class="portfolio-cover"><img src={base+"/images/projects/lounge-chairs-01.webp"} alt="Ряд уличных шезлонгов с отделкой планками под дерево" loading="lazy"/></div><div class="portfolio-details"><div><span class="projects-kicker">ПРОЕКТ 03 / МАЛЫЕ АРХИТЕКТУРНЫЕ ФОРМЫ</span><h2>Уличные шезлонги с отделкой из ДПК</h2><p>Серия шезлонгов для общественной зоны отдыха. Плавный изгиб посадочной поверхности повторяет форму тела, а планки с древесной текстурой создают аккуратный современный облик.</p><p>На фотографиях показаны шезлонги с металлическими боковыми опорами и реечным покрытием. Контраст новых и уже эксплуатируемых поверхностей позволяет оценить внешний вид материала в реальных условиях.</p><div class="portfolio-tags"><span>Шезлонги</span><span>Уличная мебель</span><span>Общественная зона отдыха</span></div><button type="button" class="nimtech-glow" data-lead-open data-lead-form="projects">Обсудить похожий проект →</button></div><div class="portfolio-gallery"><img src={base+"/images/projects/lounge-chairs-02.webp"} alt="Сравнение поверхностей двух соседних шезлонгов" loading="lazy"/><img src={base+"/images/projects/lounge-chairs-03.webp"} alt="Фактура планок шезлонга крупным планом" loading="lazy"/><img src={base+"/images/projects/lounge-chairs-04.webp"} alt="Два шезлонга с плавным изгибом" loading="lazy"/><img src={base+"/images/projects/lounge-chairs-05.webp"} alt="Ряд шезлонгов на зелёном покрытии" loading="lazy"/></div></div></article><div class="portfolio-next"><p>Портфолио пополняется новыми объектами. Следующее обновление подборки запланировано к 1 ноября 2027 года.</p></div></section> : Astro.params.section === "calculator" ? <section class="calculator-shell"><div class="calculator-heading"><h1>Калькулятор террасы</h1><p>Интерактивный прототип NimTech: раскладка доски и расчёт конструкции.</p></div><iframe title="Калькулятор террасы NimTech" src={base+"/calc-prototype/index.html"} loading="eager" allow="fullscreen"></iframe><div class="calculator-foot"><a href={base+"/calc-prototype/index.html"} target="_blank" rel="noopener">Открыть калькулятор на весь экран ↗</a></div></section> : <section class="wrap"><h1>{title}</h1><p>{description}</p><a class="btn" href={base+"/"}>На главную →</a></section>}</Base>
<style>.calculator-shell{width:100%;background:#f6f6f4}.calculator-heading{padding:32px 5% 20px}.calculator-heading h1{font-size:clamp(26px,3vw,44px);margin:0 0 8px;letter-spacing:-.04em}.calculator-heading p{margin:0;font-size:14px}.calculator-shell iframe{display:block;width:100%;height:calc(100vh - 145px);min-height:680px;border:0;background:white}.calculator-foot{padding:16px 5%;font-size:14px}.calculator-foot a{text-decoration:underline}@media(max-width:700px){.calculator-shell iframe{height:85vh;min-height:600px}}</style>

<style>.catalog-page{background:#f7f7f5}.catalog-hero{background:#202522;color:#fff;padding:100px max(5%,calc((100vw - 1240px)/2)) 105px}.catalog-hero .eyebrow{font-size:12px;letter-spacing:.2em;color:#aaa}.catalog-hero h1{font-size:clamp(36px,5.5vw,76px);line-height:1.07;letter-spacing:-.05em;margin:22px 0}.catalog-hero p{color:#c8d0cb;font-size:18px;max-width:760px}.catalog-inner{max-width:1300px;margin:auto;padding:75px 30px 110px}.catalog-inner h2{font-size:clamp(28px,3.5vw,46px);letter-spacing:-.04em}.catalog-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.catalog-card{background:white;border:1px solid #e8e8e5;padding:30px;min-height:250px;display:flex;flex-direction:column}.catalog-index{font-size:12px;color:#8d948e}.catalog-card h3{font-size:25px;line-height:1.15;margin:36px 0 5px}.catalog-card p{font-size:14px}.catalog-card span{margin-top:auto;font-size:12px;color:#777}.collection-heading{margin-top:90px}.collection-heading p{margin-bottom:30px}.collection-list{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.collection-item{background:#eaece9;padding:24px;display:flex;flex-direction:column;gap:12px}.collection-item strong{font-size:20px}.collection-item span{font-size:13px;color:#666}.catalog-note{margin-top:90px;background:#dfe7df;padding:48px}.catalog-note h2{margin:0}.catalog-note a{display:inline-block;margin-top:18px;text-decoration:underline;font-weight:bold}@media(max-width:800px){.catalog-grid,.collection-list{grid-template-columns:1fr}.catalog-hero{padding:70px 24px}.catalog-inner{padding:50px 20px}.catalog-card{min-height:190px}.catalog-card h3{margin-top:18px}}</style>

<style>.stock-products{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.stock-product{background:#fff;border:1px solid #e8e8e6;padding:23px;display:flex;flex-direction:column;min-height:200px}.stock-product-group{font-size:11px;color:#777;line-height:1.4}.stock-product h3{font-size:17px;line-height:1.35;margin:22px 0;letter-spacing:-.02em}.stock-product-bottom{margin-top:auto;display:flex;justify-content:space-between;align-items:center;gap:12px;font-size:13px}.stock-product-bottom a{text-decoration:underline;white-space:nowrap}@media(max-width:850px){.stock-products{grid-template-columns:1fr}}</style>
<style>.contact-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;margin-top:30px}.contact-grid .card{min-height:0}.contact-grid a{text-decoration:underline;text-underline-offset:3px}@media(max-width:700px){.contact-grid{grid-template-columns:1fr}}</style>
<style>.showroom-map{margin-top:46px}.showroom-map h2{font-size:clamp(24px,3vw,36px)}.showroom-map iframe{width:100%;height:430px;border:0;border-radius:14px;background:#eceeea}.showroom-map a{text-decoration:underline}@media(max-width:700px){.showroom-map iframe{height:340px}}</style>
<style>.projects-placeholder{min-height:65vh;display:grid;place-items:center;padding:90px 24px;background:radial-gradient(ellipse at 80% 10%,#e4e2db 0%,transparent 52%),#f6f5f2;text-align:center}.projects-placeholder-inner{max-width:780px}.projects-kicker{font-size:12px;letter-spacing:.22em;font-weight:700;color:#7a7c7a}.projects-symbol{font-size:68px;color:#8c9290;margin:22px 0}.projects-placeholder h1{font-size:clamp(44px,7vw,82px);margin:0 0 12px}.projects-placeholder h2{font-size:clamp(22px,3vw,32px);font-weight:500;margin:0 0 22px}.projects-placeholder p{margin:0 auto 28px;font-size:17px;line-height:1.7}.projects-date{display:flex;flex-direction:column;gap:7px;margin-bottom:28px}.projects-date span{font-size:13px;color:#777}.projects-date strong{font-size:22px}.projects-placeholder button{font-family:inherit}</style>

<style>.projects-portfolio{background:#f6f5f2;padding:68px 24px 95px}.projects-portfolio-head,.portfolio-project,.portfolio-next{max-width:1220px;margin:auto}.projects-portfolio-head{margin-bottom:40px}.projects-portfolio-head h1{font-size:clamp(44px,6vw,80px);margin:14px 0}.projects-portfolio-head p{font-size:18px}.portfolio-project{background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 18px 65px #10182012}.portfolio-cover img{width:100%;height:clamp(300px,52vw,620px);object-fit:cover;display:block}.portfolio-details{display:grid;grid-template-columns:1fr 1fr;gap:36px;padding:40px}.portfolio-details h2{font-size:clamp(28px,3vw,42px);line-height:1.15;margin:14px 0}.portfolio-details p{line-height:1.7}.portfolio-gallery{display:grid;grid-template-columns:1fr;gap:15px}.portfolio-gallery img{width:100%;height:230px;object-fit:cover;border-radius:10px}.portfolio-tags{display:flex;flex-wrap:wrap;gap:8px;margin:24px 0}.portfolio-tags span{background:#f0efeb;border-radius:20px;padding:8px 12px;font-size:12px}.portfolio-next{margin-top:30px;font-size:13px;color:#777}.projects-kicker{font-size:11px;letter-spacing:.17em;font-weight:700;color:#81817d}@media(max-width:750px){.portfolio-details{grid-template-columns:1fr;padding:23px}.portfolio-gallery{grid-template-columns:1fr 1fr}.portfolio-gallery img{height:145px}}</style>

<style>.portfolio-project-second{margin-top:42px}.portfolio-project-second .portfolio-gallery{grid-template-columns:repeat(2,minmax(0,1fr))}.portfolio-project-second .portfolio-gallery img{height:175px}@media(max-width:600px){.portfolio-project-second .portfolio-gallery img{height:120px}}</style>

<style>.showroom-gallery{margin:50px auto;max-width:1220px}.showroom-gallery-heading{max-width:730px;margin-bottom:22px}.showroom-gallery-heading h2{font-size:clamp(28px,4vw,46px);margin:12px 0}.showroom-gallery-heading p{line-height:1.65}.showroom-photos{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:12px}.showroom-photos img{width:100%;height:230px;object-fit:cover;border-radius:12px;grid-column:span 2}.showroom-photos img:nth-child(1),.showroom-photos img:nth-child(2){grid-column:span 3;height:300px}@media(max-width:680px){.showroom-photos{grid-template-columns:1fr 1fr}.showroom-photos img,.showroom-photos img:nth-child(1),.showroom-photos img:nth-child(2){grid-column:span 1;height:160px}.showroom-photos img:first-child{grid-column:span 2;height:230px}}</style>
