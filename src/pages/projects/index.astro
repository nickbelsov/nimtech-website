---
import Base from '../../layouts/Base.astro';
const projects=[["ТЕРРАСЫ И ЗОНЫ ОТДЫХА","Терраса вокруг бассейна","Просторная террасная площадка вокруг частного открытого бассейна. Настил формирует единую зону отдыха, соединяя бассейн с участком и прилегающими постройками.","На фотографиях — вечерние виды объекта в процессе завершающих работ. Видны террасное покрытие, обрамление бассейна и примыкания к дорожкам.","terrace-pool",3],["ТЕРРАСА У ДОМА","Терраса с широкими ступенями у загородного дома","Светлая террасная площадка вдоль фасада современного одноэтажного дома. Настил образует просторную зону отдыха с мебелью, а широкие ступени обеспечивают удобный переход к дорожкам и участку.","Особое внимание уделено аккуратной отделке торцов и подступенков. Тёплый оттенок покрытия гармонирует с вертикальными фасадными панелями и ландшафтным оформлением.","terrace-house",5],["МАЛЫЕ АРХИТЕКТУРНЫЕ ФОРМЫ","Уличные шезлонги с отделкой из ДПК","Серия шезлонгов для общественной зоны отдыха. Плавный изгиб посадочной поверхности повторяет форму тела, а планки с древесной текстурой создают аккуратный современный облик.","На фотографиях показаны шезлонги с металлическими боковыми опорами и реечным покрытием.","lounge-chairs",5],["ТЕРРАСА НА КРОВЛЕ","Терраса из ДПК на эксплуатируемой кровле","Террасный настил с выраженной древесной фактурой у кирпичного фасада современного здания. На фотографиях показан процесс монтажа покрытия и устройство основания на кровле.","Под настилом видны металлический каркас и регулируемые опоры. Фотографии фиксируют последовательность работ: от подготовки несущей конструкции до укладки террасной доски.","roof-terrace",4],["ТЕРРАСА У ПАВИЛЬОНА","Терраса из ДПК вокруг стеклянного павильона","Террасный настил обрамляет современный павильон с панорамным остеклением. Доска с древесной текстурой сочетается с тёмными архитектурными элементами здания и мощением прилегающей территории.","В проекте предусмотрены широкие входные ступени, отделка торцов настила и декоративная подсветка по краю террасы.","glass-pavilion",5],["ТЕРРАСА У БАССЕЙНА · МОСКОВСКАЯ ОБЛАСТЬ","Терраса вокруг бассейна и круглой купели в Московской области","Террасная площадка на загородном участке объединяет прямоугольный открытый бассейн и круглую купель. На фотографиях показан этап устройства металлической подконструкции вокруг чаш.","Металлический каркас формирует основание будущего настила. Особое внимание уделяется геометрии площадки и примыканиям к бассейну и купели. Объект представлен на стадии монтажа, до укладки финишного покрытия.","pool-frame-mo",4],["ЖИЛОЙ КОМПЛЕКС · МОСКВА","Терраса и декоративные кашпо из ДПК в ЖК «Мичуринский парк»","Устройство террасы и декоративных кашпо из древесно-полимерного композита в жилом комплексе «Мичуринский парк» в Москве для застройщика «Группа компаний ПИК».","Выполнены металлическая подконструкция, террасный настил, облицовка широких ступеней и декоративных кашпо из ДПК. В галерее представлены готовый объект, этапы зимнего монтажа и схема расположения регулируемых опор.","michurinskiy-park",6],["ЭКСПЛУАТИРУЕМАЯ КРОВЛЯ · САМАРА","Эксплуатируемая кровля круглогодичного кафе на берегу Волги","Устройство эксплуатируемой кровли для круглогодичного кафе в Самаре, на берегу Волги. Террасный настил из ДПК смонтирован на винтовых регулируемых опорах.","На кровле организована открытая зона отдыха с видом на Волгу: установлены столики, скамейки и стеклянные ограждения. На фотографиях — готовый объект в зимних условиях и детали террасного покрытия.","samara-cafe",5],["ЭКСПЛУАТИРУЕМАЯ КРОВЛЯ · МОСКВА","Эксплуатируемая кровля на 20-м этаже ЖК «Роттердам»","Устройство террасы на эксплуатируемой кровле жилого комплекса на высоте 20-го этажа. Серое террасное покрытие с древесной фактурой создаёт комфортное пространство для отдыха с видом на город.","Для основания использованы регулируемые опоры и металлическая подконструкция. Выполнены укладка террасной доски и аккуратные примыкания к фасаду и панорамному стеклянному ограждению. В галерее — готовый результат и этапы монтажа.","rotterdam",7]];
---
<Base title="Наши работы — реализованные проекты NimTech" description="Реализованные террасы и эксплуатируемые кровли NimTech в Москве: фотографии, этапы монтажа, ЖК Роттердам.">
<main class="page-width works"><h1 class="sr-only">Наши работы — реализованные проекты NimTech</h1>
{projects.map((p,i)=><section class="project" id={p[4]}><div class="heading"><div class="eyebrow">ПРОЕКТ {String(i+1).padStart(2,'0')} / {p[0]}</div><h2>{p[1]}</h2><p>{p[2]}</p><details class="project-more"><summary>Подробнее о проекте</summary><p>{p[3]}</p></details><button type="button" class="action" data-lead-open data-lead-form="projects_similar" data-project-name={p[1]}>Рассчитать похожий проект →</button></div>{p[5]>0 && <div class="gallery">{Array.from({length:Math.min(p[5],3)},(_,j)=><button type="button" class="gallery-photo" data-gallery={p[4]} data-index={j} data-title={p[1]} data-count={p[5]} aria-label={`Открыть фото ${j+1} из ${p[5]} проекта ${p[1]}`}><img src={`/images/projects/${p[4]}-${String(j+1).padStart(2,'0')}.webp`} alt={`${p[1]} — фотография ${j+1}`} loading="lazy" decoding="async"/></button> )}</div>}</section>)}
<section class="cta"><h2>Рассчитать ваш проект</h2><p>Оставьте контакты — обсудим размеры, основание и стоимость работ.</p><a class="action" href="/contacts/">Связаться с нами →</a></section></main>
<div class="photo-viewer" id="photo-viewer" role="dialog" aria-modal="true" aria-label="Просмотр фотографий проекта" hidden>
 <button type="button" class="viewer-close" aria-label="Закрыть просмотр">×</button>
 <button type="button" class="viewer-nav viewer-prev" aria-label="Предыдущее фото">‹</button>
 <figure class="viewer-figure"><img id="viewer-image" alt=""/><figcaption><span id="viewer-title"></span><span id="viewer-counter"></span></figcaption></figure>
 <button type="button" class="viewer-nav viewer-next" aria-label="Следующее фото">›</button>
</div>
<script>
 const viewer=document.getElementById('photo-viewer');
 const image=document.getElementById('viewer-image');
 const title=document.getElementById('viewer-title');
 const counter=document.getElementById('viewer-counter');
 let gallery='',index=0,count=0,projectTitle='',lastFocus=null;
 const show=()=>{if(!image||!title||!counter)return;image.src='/images/projects/'+gallery+'-'+String(index+1).padStart(2,'0')+'.webp';image.alt=projectTitle+' — фотография '+(index+1);title.textContent=projectTitle;counter.textContent=(index+1)+' / '+count;};
 const close=()=>{if(!viewer)return;viewer.hidden=true;document.body.style.overflow='';image?.removeAttribute('src');lastFocus?.focus();};
 const move=(delta)=>{index=(index+delta+count)%count;show();};
 document.querySelectorAll('.gallery-photo').forEach(button=>button.addEventListener('click',()=>{gallery=button.dataset.gallery||'';index=Number(button.dataset.index)||0;count=Number(button.dataset.count)||1;projectTitle=button.dataset.title||'';lastFocus=button;viewer.hidden=false;document.body.style.overflow='hidden';show();viewer.querySelector('.viewer-close')?.focus();}));
 viewer?.querySelector('.viewer-close')?.addEventListener('click',close);
 viewer?.querySelector('.viewer-prev')?.addEventListener('click',()=>move(-1));
 viewer?.querySelector('.viewer-next')?.addEventListener('click',()=>move(1));
 viewer?.addEventListener('click',e=>{if(e.target===viewer)close();});
 document.addEventListener('keydown',e=>{if(viewer?.hidden)return;if(e.key==='Escape')close();if(e.key==='ArrowLeft')move(-1);if(e.key==='ArrowRight')move(1);});
 let touchX=null;
 viewer?.addEventListener('touchstart',e=>{touchX=e.touches[0]?.clientX??null;},{passive:true});
 viewer?.addEventListener('touchend',e=>{if(touchX===null)return;const diff=(e.changedTouches[0]?.clientX??touchX)-touchX;if(Math.abs(diff)>45)move(diff>0?-1:1);touchX=null;},{passive:true});
</script>
</Base>
<style>.works{width:100%;max-width:1200px;margin:0 auto;padding:70px 24px 90px;min-width:0}.works h1{font-size:clamp(42px,6vw,78px);line-height:1.05;letter-spacing:-.05em;margin:14px 0}.intro{font-size:19px;color:#6b6b6b;margin-bottom:60px}.eyebrow{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#888}.project{padding:50px 0 70px;border-top:1px solid #dedede}.heading{max-width:820px;margin-bottom:30px}.heading h2{font-size:clamp(27px,3.3vw,46px);letter-spacing:-.035em;line-height:1.15;margin:14px 0 20px}.heading p{font-size:17px;line-height:1.7;color:#555}.action{display:inline-block;font:inherit;cursor:pointer;border:0;margin-top:12px;background:#222;color:white;padding:14px 24px;text-decoration:none;border-radius:4px}.gallery{display:grid;width:100%;min-width:0;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.gallery :global(img){display:block;min-width:0;width:100%;height:260px;object-fit:cover;border-radius:4px;background:#eee}.gallery :global(img:first-child){grid-column:span 2;grid-row:span 2;height:532px}.cta{padding:45px;background:#f4f4f2}.cta h2{font-size:34px;margin:0 0 10px}@media(max-width:720px){.works{padding:35px 16px 60px}.project{padding:35px 0}.gallery{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.gallery :global(img){height:150px}.gallery :global(img:first-child){grid-column:span 2;grid-row:span 1;height:260px}}</style>
<style>
.gallery :global(.gallery-photo){appearance:none;border:0;background:#eee;padding:0;cursor:zoom-in;display:block;min-width:0;width:100%;overflow:hidden;border-radius:4px}
.gallery :global(.gallery-photo:first-child){grid-column:span 2;grid-row:span 2}
.gallery :global(.gallery-photo img){display:block;width:100%;height:260px;object-fit:cover;transition:transform .25s}
.gallery :global(.gallery-photo:first-child img){height:532px}
.gallery :global(.gallery-photo:hover img){transform:scale(1.035)}
.gallery :global(.gallery-photo:focus-visible){outline:3px solid #3275ce;outline-offset:3px}
.photo-viewer{position:fixed;inset:0;z-index:99999;background:rgba(0,0,0,.94);display:flex;align-items:center;justify-content:center;padding:55px 70px 30px}
.photo-viewer[hidden]{display:none}
.viewer-figure{margin:0;max-width:100%;width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px}
.viewer-figure img{display:block;max-width:100%;max-height:calc(100vh - 145px);width:auto;height:auto;object-fit:contain}
.viewer-figure figcaption{color:white;font-size:14px;display:flex;gap:24px;justify-content:center;text-align:center}
.viewer-close,.viewer-nav{position:absolute;z-index:1;border:0;background:rgba(255,255,255,.12);color:white;cursor:pointer;border-radius:50%;display:grid;place-items:center}
.viewer-close{top:14px;right:18px;width:44px;height:44px;font-size:32px}
.viewer-nav{top:50%;transform:translateY(-50%);width:48px;height:48px;font-size:40px}
.viewer-prev{left:12px}.viewer-next{right:12px}
@media(max-width:720px){.gallery :global(.gallery-photo:first-child){grid-row:span 1}.gallery :global(.gallery-photo img){height:150px}.gallery :global(.gallery-photo:first-child img){height:260px}.photo-viewer{padding:65px 12px 45px}.viewer-nav{width:38px;height:38px;font-size:30px;background:rgba(0,0,0,.4)}.viewer-prev{left:3px}.viewer-next{right:3px}.viewer-figure img{max-height:calc(100vh - 165px)}}
</style>
<style>
/* Compact portfolio: one project per short viewport section */
.works{max-width:1280px;padding-top:18px;padding-bottom:56px;box-sizing:border-box}
.works .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.project{display:grid;grid-template-columns:minmax(0,0.9fr) minmax(0,1.1fr);align-items:center;gap:28px;padding:24px 0;border-top:1px solid #e5e5e5;min-width:0}
.project .heading{min-width:0;margin:0;max-width:none}
.project .heading h2{font-size:clamp(23px,2.1vw,32px);margin:8px 0 12px;line-height:1.18}
.project .heading p{font-size:15px;line-height:1.5;margin:0 0 10px}
.project .eyebrow{font-size:11px}
.project .action{font-size:14px;padding:11px 16px;margin-top:12px}
.project-more{font-size:14px;color:#555;margin:8px 0}
.project-more summary{cursor:pointer;color:#333;text-decoration:underline;text-underline-offset:3px}
.project-more p{padding-top:9px}
.project .gallery{display:grid;grid-template-columns:2fr 1fr;grid-template-rows:repeat(2,minmax(0,1fr));gap:8px;min-width:0;height:290px}
.project .gallery :global(.gallery-photo){grid-column:auto;grid-row:auto;height:100%;min-height:0}
.project .gallery :global(.gallery-photo:first-child){grid-column:1;grid-row:1 / 3}
.project .gallery :global(.gallery-photo img),.project .gallery :global(.gallery-photo:first-child img){width:100%;height:100%;object-fit:cover}
.project .gallery :global(.gallery-photo:nth-child(2)){grid-column:2;grid-row:1}
.project .gallery :global(.gallery-photo:nth-child(3)){grid-column:2;grid-row:2}
@media(max-width:760px){.works{padding:10px 16px 40px}.project{grid-template-columns:1fr;gap:14px;padding:22px 0}.project .heading h2{font-size:24px}.project .gallery{height:230px}.project .heading p{font-size:14px}}
</style>
