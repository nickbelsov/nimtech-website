---
import Base from '../../layouts/Base.astro';
const projects=[["ТЕРРАСЫ И ЗОНЫ ОТДЫХА","Терраса вокруг бассейна","Просторная террасная площадка вокруг частного открытого бассейна. Настил формирует единую зону отдыха, соединяя бассейн с участком и прилегающими постройками.","На фотографиях — вечерние виды объекта в процессе завершающих работ. Видны террасное покрытие, обрамление бассейна и примыкания к дорожкам.","terrace-pool",3],["ТЕРРАСА У ДОМА","Терраса с широкими ступенями у загородного дома","Светлая террасная площадка вдоль фасада современного одноэтажного дома. Настил образует просторную зону отдыха с мебелью, а широкие ступени обеспечивают удобный переход к дорожкам и участку.","Особое внимание уделено аккуратной отделке торцов и подступенков. Тёплый оттенок покрытия гармонирует с вертикальными фасадными панелями и ландшафтным оформлением.","terrace-house",5],["МАЛЫЕ АРХИТЕКТУРНЫЕ ФОРМЫ","Уличные шезлонги с отделкой из ДПК","Серия шезлонгов для общественной зоны отдыха. Плавный изгиб посадочной поверхности повторяет форму тела, а планки с древесной текстурой создают аккуратный современный облик.","На фотографиях показаны шезлонги с металлическими боковыми опорами и реечным покрытием.","lounge-chairs",5],["ТЕРРАСА НА КРОВЛЕ","Терраса из ДПК на эксплуатируемой кровле","Террасный настил с выраженной древесной фактурой у кирпичного фасада современного здания. На фотографиях показан процесс монтажа покрытия и устройство основания на кровле.","Под настилом видны металлический каркас и регулируемые опоры. Фотографии фиксируют последовательность работ: от подготовки несущей конструкции до укладки террасной доски.","roof-terrace",4],["ТЕРРАСА У ПАВИЛЬОНА","Терраса из ДПК вокруг стеклянного павильона","Террасный настил обрамляет современный павильон с панорамным остеклением. Доска с древесной текстурой сочетается с тёмными архитектурными элементами здания и мощением прилегающей территории.","В проекте предусмотрены широкие входные ступени, отделка торцов настила и декоративная подсветка по краю террасы.","glass-pavilion",5],["ЭКСПЛУАТИРУЕМАЯ КРОВЛЯ · МОСКВА","Эксплуатируемая кровля на 20-м этаже ЖК «Роттердам»","Устройство террасы на эксплуатируемой кровле жилого комплекса на высоте 20-го этажа. Серое террасное покрытие с древесной фактурой создаёт комфортное пространство для отдыха с видом на город.","Для основания использованы регулируемые опоры и металлическая подконструкция. Выполнены укладка террасной доски и аккуратные примыкания к фасаду и панорамному стеклянному ограждению. В галерее — готовый результат и этапы монтажа.","rotterdam",7]];
---
<Base title="Наши работы — реализованные проекты NimTech" description="Реализованные террасы и эксплуатируемые кровли NimTech в Москве: фотографии, этапы монтажа, ЖК Роттердам.">
<main class="page-width works"><div class="eyebrow">NIMTECH / РЕАЛИЗОВАННЫЕ ОБЪЕКТЫ</div><h1>Наши работы</h1><p class="intro">Примеры террас и архитектурных решений из древесно-полимерного композита.</p>
{projects.map((p,i)=><section class="project" id={p[4]}><div class="heading"><div class="eyebrow">ПРОЕКТ {String(i+1).padStart(2,'0')} / {p[0]}</div><h2>{p[1]}</h2><p>{p[2]}</p><p>{p[3]}</p><a href="/calculator/" class="action">Рассчитать похожий проект →</a></div><div class="gallery">{Array.from({length:p[5]},(_,j)=><img src={`/images/projects/${p[4]}-${String(j+1).padStart(2,'0')}.webp`} alt={`${p[1]} — фотография ${j+1}`} loading="lazy" decoding="async"/> )}</div></section>)}
<section class="cta"><h2>Рассчитать ваш проект</h2><p>Оставьте контакты — обсудим размеры, основание и стоимость работ.</p><a class="action" href="/contacts/">Связаться с нами →</a></section></main>
</Base>
<style>.works{padding-top:70px;padding-bottom:90px}.works h1{font-size:clamp(42px,6vw,78px);line-height:1.05;letter-spacing:-.05em;margin:14px 0}.intro{font-size:19px;color:#6b6b6b;margin-bottom:60px}.eyebrow{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#888}.project{padding:50px 0 70px;border-top:1px solid #dedede}.heading{max-width:820px;margin-bottom:30px}.heading h2{font-size:clamp(27px,3.3vw,46px);letter-spacing:-.035em;line-height:1.15;margin:14px 0 20px}.heading p{font-size:17px;line-height:1.7;color:#555}.action{display:inline-block;margin-top:12px;background:#222;color:white;padding:14px 24px;text-decoration:none;border-radius:4px}.gallery{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.gallery img{width:100%;height:260px;object-fit:cover;border-radius:4px;background:#eee}.gallery img:first-child{grid-column:span 2;grid-row:span 2;height:532px}.cta{padding:45px;background:#f4f4f2}.cta h2{font-size:34px;margin:0 0 10px}@media(max-width:720px){.works{padding-top:35px}.project{padding:35px 0}.gallery{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.gallery img{height:150px}.gallery img:first-child{grid-column:span 2;grid-row:span 1;height:260px}}</style>