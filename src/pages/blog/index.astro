---
<Base title="Полезные материалы NimTech — монтаж террас, выбор ДПК и советы экспертов" description="Практические статьи NimTech о строительстве террас, монтаже ДПК, выборе террасной доски и правильной подконструкции. Видео и инструкции.">
<section class="wrap"><p class="eyebrow">ЖУРНАЛ NIMTECH</p><h1>Полезные материалы о террасах и материалах</h1><p class="lead">Реальные технологии, ошибки и решения из нашей практики. На основе видео и опыта команды NimTech.</p>
<div class="filters" role="group" aria-label="Фильтр материалов по темам">
{['Все статьи','Террасы и идеи','Выбор доски','Монтаж','Ступени и ограждения','Испытания и срок службы','Производство','Покупка и цены'].map((category,i)=><button type="button" class:list={['filter',{active:i===0}]} data-filter={category} aria-pressed={i===0?'true':'false'}>{category}</button>)}
</div>
<p class="results" aria-live="polite">Показано материалов: <span id="visible-count">{articles.length}</span></p>
<div class="grid" id="article-grid">{articles.map(a=><a class="article" href={'/blog/'+a.slug+'/'} data-category={a.category} data-tags={a.tags.join(' ')}><img src={a.image} alt={a.title + " — иллюстрация к статье NimTech"} loading="lazy"/><div class="body"><small>{a.category} · {a.date}</small><h2>{a.title}</h2><p>{a.description}</p><div class="hashtags">{a.tags.map(t=><span>#{t}</span>)}</div><span class="read">Читать статью ↗</span></div></a>)}</div>
<p id="no-results" hidden>По выбранной теме пока нет статей. Скоро добавим новые материалы.</p></section>
<script is:inline>
const buttons=document.querySelectorAll('[data-filter]');
const cards=document.querySelectorAll('#article-grid .article');
const count=document.getElementById('visible-count');
const empty=document.getElementById('no-results');
function selectTopic(topic){
let visible=0;
cards.forEach(card=>{const show=topic==='Все статьи'||card.dataset.category===topic;card.hidden=!show;if(show)visible++;});
buttons.forEach(btn=>{const selected=btn.dataset.filter===topic;btn.classList.toggle('active',selected);btn.setAttribute('aria-pressed',String(selected));});
count.textContent=String(visible);empty.hidden=visible!==0;
}
buttons.forEach(btn=>btn.addEventListener('click',()=>{selectTopic(btn.dataset.filter);history.replaceState(null,'',btn.dataset.filter==='Все статьи'?location.pathname:'?topic='+encodeURIComponent(btn.dataset.filter));}));
const initial=new URLSearchParams(location.search).get('topic');if(initial&&[...buttons].some(btn=>btn.dataset.filter===initial))selectTopic(initial);
</script>
</Base>
<style>.eyebrow{font-size:12px;font-weight:700;letter-spacing:.18em;color:#777}.lead{font-size:20px;max-width:750px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px;margin-top:48px}.article{display:block;border:1px solid #e5e5e0;background:white;border-radius:14px;overflow:hidden}.article img{display:block;width:100%;aspect-ratio:16/9;object-fit:cover}.body{padding:24px}.body small{color:#777}.body h2{font-size:25px;letter-spacing:-.025em}.body p{font-size:15px}.body span{font-weight:700;font-size:14px}</style>
<style>.filters{display:flex;flex-wrap:wrap;gap:10px;margin-top:34px}.filter{border:1px solid #d7d7d2;background:#fff;border-radius:999px;padding:11px 17px;font:inherit;font-size:14px;cursor:pointer;transition:background .15s,color .15s}.filter:hover,.filter:focus-visible{border-color:#222}.filter.active{background:#171717;color:white;border-color:#171717}.results{font-size:13px;color:#666;margin-top:22px}.article[hidden],#no-results[hidden]{display:none!important}.hashtags{display:flex;flex-wrap:wrap;gap:6px;margin:14px 0 18px}.hashtags span{font-size:12px;color:#555;background:#f1f1ee;border-radius:7px;padding:6px 8px}.body .read{font-weight:700;font-size:14px}#no-results{margin:35px 0;color:#666}@media(max-width:600px){.filters{gap:8px}.filter{font-size:13px;padding:9px 12px}}</style>