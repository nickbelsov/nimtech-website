const data={"@context":"https://schema.org","@graph":[{"@type":"BlogPosting","headline":"ДПК или МПК: сравнение террасной и минеральной доски","description":"Чем отличается ДПК от МПК: состав, вес, влагостойкость, монтаж, цена и область применения. Разбор материалов на примере видео NimTech.","inLanguage":"ru-RU","datePublished":"2026-10-24","dateModified":"2026-10-24","author":{"@type":"Organization","name":"NimTech"},"publisher":{"@type":"Organization","name":"NimTech","url":"https://nimtech.ru"},"mainEntityOfPage":"https://nimtech.ru/blog/dpk-ili-mpk-sravnenie/"},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Главная","item":"https://nimtech.ru/"},{"@type":"ListItem","position":2,"name":"Блог","item":"https://nimtech.ru/blog/"},{"@type":"ListItem","position":3,"name":"ДПК или МПК: сравнение террасной и минеральной доски","item":"https://nimtech.ru/blog/dpk-ili-mpk-sravnenie/"}]},{"@type":"VideoObject","name":"ДПК или МПК: сравнение террасной и минеральной доски","description":"Чем отличается ДПК от МПК: состав, вес, влагостойкость, монтаж, цена и область применения. Разбор материалов на примере видео NimTech.","thumbnailUrl":"https://i.ytimg.com/vi/qjPUYbg9IBE/hqdefault.jpg","embedUrl":"https://www.youtube-nocookie.com/embed/qjPUYbg9IBE","url":"https://www.youtube.com/watch?v=qjPUYbg9IBE"}]};
