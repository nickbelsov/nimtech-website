const steps=[
{n:"01",title:"Замер",desc:"Выезжаем на объект, проводим точные замеры, оцениваем основание, перепады высот, примыкания к дому и технические особенности.",points:["Замер и фотофиксация","Оценка основания","Консультация по решениям"],kind:"measure"},
{n:"02",title:"Проект и документация",desc:"Разрабатываем конструктивное решение: расположение опор, металлокаркас, лаги, раскладку доски, узлы примыканий и спецификацию материалов.",points:["Схемы раскладки и узлы","Расчёт материалов","Согласование проекта"],kind:"project"},
{n:"03",title:"Поставка материалов",desc:"Комплектуем заказ и организуем поставку террасной доски, металлокаркаса, опор, крепежа и расходных материалов на объект.",points:["Комплектация заказа","Согласование доставки","Поставка на объект"],kind:"delivery"},
{n:"04",title:"Монтаж",desc:"Выполняем монтаж подконструкции и покрытия, контролируем геометрию, качество креплений и аккуратность финишных узлов.",points:["Монтаж подконструкции","Укладка террасной доски","Проверка и сдача работ"],kind:"install"},
{n:"05",title:"Гарантия и обслуживание",desc:"После сдачи объекта остаёмся на связи, исполняем гарантийные обязательства и обеспечиваем обслуживание в соответствии с договором.",points:["Гарантийные обязательства","Консультации по эксплуатации","Обслуживание по договору"],kind:"warranty"}
];
---
<section class="turnkey">
 <div class="hero"><div><span class="eyebrow">NIMTECH · ПОЛНЫЙ ЦИКЛ</span><h1>Террасы под ключ</h1><p>Берём на себя весь процесс — от первого замера до сдачи готовой террасы и гарантийного обслуживания.</p></div><a class="action" href="https://t.me/+79770893443" target="_blank" rel="noopener noreferrer">Получить консультацию ↗</a></div>
 <div class="process"><div class="heading"><span class="eyebrow">ПОНЯТНЫЙ ПРОЦЕСС</span><h2>5 этапов нашей работы</h2><p>Один подрядчик на всех этапах: проектирование, материалы, строительство и поддержка.</p></div>
 <div class="steps">{steps.map((step)=><article class="step"><div class="step-label"><span class="number">{step.n}</span><h3>{step.title}</h3></div><div class={'visual '+step.kind} aria-label={'Иллюстрация этапа: '+step.title}>
