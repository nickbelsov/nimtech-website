x;color:#888;margin-top:18px}@media(max-width:1200px){.steps{grid-template-columns:repeat(3,minmax(0,1fr))}.step-desc{min-height:0}.step ul{min-height:0}}@media(max-width:750px){.turnkey{padding:35px 20px 55px}.hero,.cta{flex-direction:column;align-items:stretch}.steps{grid-template-columns:1fr}.visual{height:230px}.step{padding-bottom:20px;border-bottom:1px solid #ddd}.step-desc{margin-bottom:16px}.cta{padding:25px}.action{white-space:normal}.heading{padding-top:35px}}
